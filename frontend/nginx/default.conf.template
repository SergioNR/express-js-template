# Rendered by the nginx image entrypoint (envsubst) into
# /etc/nginx/conf.d/default.conf - only defined env vars are substituted, so
# nginx variables like $uri are left untouched.
server {
  listen 8080;
  server_name localhost;

  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types text/plain text/css application/javascript application/json image/svg+xml application/xml;

  include /etc/nginx/conf.d/security-headers.inc;

  # SPA history fallback - unknown paths render index.html
  location / {
    try_files $uri $uri/ /index.html;
  }

  # The entry document must always be revalidated so new deploys are picked up
  location = /index.html {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "no-cache" always;
  }

  # Vite emits content-hashed filenames under /assets/ - safe to cache forever
  location /assets/ {
    include /etc/nginx/conf.d/security-headers.inc;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
    access_log off;
  }

  error_log /var/log/nginx/error.log warn;
  access_log /var/log/nginx/access.log;
}
