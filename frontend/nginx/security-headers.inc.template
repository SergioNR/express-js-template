# Security headers - included in the server block AND in every location that
# sets its own add_header (nginx does not inherit add_header into locations
# that define any). `always` keeps them on error responses too.
# ${NGINX_CSP_API_ORIGIN} and ${NGINX_CSP_CONNECT_EXTRA} are substituted by
# envsubst at container start. NGINX_CSP_CONNECT_EXTRA is a space-separated
# list of extra connect-src origins the browser talks to directly - e.g. the
# S3/MinIO origin presigned uploads/downloads go to. It must be defined (even
# empty) in the image, otherwise envsubst leaves the placeholder in the header.
add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://eu-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ${NGINX_CSP_API_ORIGIN} ${NGINX_CSP_CONNECT_EXTRA} https://eu.i.posthog.com https://eu-assets.i.posthog.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
add_header X-Frame-Options "DENY" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "no-referrer" always;
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
