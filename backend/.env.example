NODE_ENV=development
DEPLOY_ENVIRONMENT=
#* Reverse proxy hops to trust for X-Forwarded-* (e.g. 1), `false`, or a
#* comma-separated subnet list. Required unless DEPLOY_ENVIRONMENT=localhost
TRUST_PROXY=

POSTHOG_API_KEY=

SESSION_SECRET=

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
#* Brevo transactional template ids (https://my.brevo.com/camp/template/<id>/setup).
#* Every template receives `appOrigin` (= FRONT_WEB_APP_ORIGIN_URL) to build links
BREVO_RESET_PASSWORD_TEMPLATE_ID=2
BREVO_TEAM_INVITE_TEMPLATE_ID=3
BREVO_ACCOUNT_EXISTS_TEMPLATE_ID=

#* Direct (non-pooled) URL for migrations/seed; pooled/runtime URL for the API
PRISMA_POSTGRES_DIRECT_URL=
PRISMA_POSTGRES_CONNECTION_STRING=

#* Optional - error alerts are skipped when the bot key is unset
TELEGRAM_BOT_API_KEY=
TELEGRAM_ERRORS_CHAT_ID=

FRONT_WEB_APP_ORIGIN_URL=

STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PRICE_ID_BASIC_MONTHLY=
STRIPE_PRICE_ID_BASIC_YEARLY=
STRIPE_PRICE_ID_PRO_MONTHLY=
STRIPE_PRICE_ID_PRO_YEARLY=

#* S3-compatible file storage (AWS S3 or MinIO). The files feature is only
#* enabled when S3_BUCKET is set; leave the block empty to run without it.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
S3_MAX_FILE_SIZE_MB=50
S3_ALLOWED_MIME_TYPES=

PORT=3000

POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
