{
  "name": "expressjs-template-frontend",
  "engines": {
    "node": ">=26"
  },
  "description": "React (Vite) frontend for the Express.js template",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "keywords": [],
  "license": "Proprietary",
  "author": "Sergio Navarro Redondo",
  "scripts": {
    "build": "vite build",
    "start:local": "vite",
    "docker-build:local": "docker build --platform=linux/amd64 --build-arg VITE_API_BASE_URL=http://localhost:3000 -t expressjs-template-front:local .",
    "docker-build:prod": "docker build -t expressjs-template-front:latest . && docker push expressjs-template-front:latest",
    "docker-build:dev": "docker build --platform=linux/amd64 -t expressjs-template-front:next . && docker push expressjs-template-front:next"
  },
  "dependencies": {
    "@mantine/core": "^9.7.3",
    "@mantine/form": "^9.7.3",
    "@mantine/hooks": "^9.7.3",
    "@mantine/notifications": "^9.7.3",
    "@tabler/icons-react": "^3.31.0",
    "axios": "^1.7.9",
    "i18next": "^26.5.3",
    "js-cookie": "^3.0.5",
    "posthog-js": "^1.257.2",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.1.0",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.18.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postcss": "^8.5.3",
    "postcss-preset-mantine": "^1.17.0",
    "postcss-simple-vars": "^7.0.1",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "core-js@3.51.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
