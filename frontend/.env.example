# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:3000

# Optional: PostHog project key. Analytics stay disabled when unset
VITE_PUBLIC_POSTHOG_KEY=

# Public URL of the deployed frontend - required for `npm run build`
# (canonical/og:url tags); the dev server defaults to http://localhost:5173
VITE_SITE_BASE_URL=http://localhost:5173

# --- Runtime (nginx container, not baked into the bundle) ---
# API origin allowed by the Content-Security-Policy connect-src. Defaults to
# the VITE_API_BASE_URL build arg; override with `docker run -e ...`
NGINX_CSP_API_ORIGIN=http://localhost:3000
